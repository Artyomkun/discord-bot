{<<"links">>,[{<<"GitHub">>,<<"https://github.com/Qqwy/elixir_number/">>}]}.
{<<"name">>,<<"numbers">>}.
{<<"version">>,<<"5.2.5">>}.
{<<"description">>,
 <<"Numbers dispatches on any numeric type that follows the `Numeric` behaviour.\nThis allows you to create composite types working with _any_ numeric type (Decimal, Ratio, Tensor, ComplexNum, ???)!">>}.
{<<"elixir">>,<<"~> 1.4">>}.
{<<"app">>,<<"numbers">>}.
{<<"files">>,
 [<<"lib">>,<<"lib/numbers">>,<<"lib/numbers/protocols.ex">>,
  <<"lib/numbers/operators.ex">>,<<"lib/numbers/implementations">>,
  <<"lib/numbers/implementations/float.ex">>,
  <<"lib/numbers/implementations/decimal.ex">>,
  <<"lib/numbers/implementations/integer.ex">>,<<"lib/numbers/helper.ex">>,
  <<"lib/numbers.ex">>,<<"mix.exs">>,<<"README.md">>,<<"LICENSE">>]}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"requirements">>,
 [[{<<"name">>,<<"coerce">>},
   {<<"app">>,<<"coerce">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 1.0.2">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"decimal">>},
   {<<"app">>,<<"decimal">>},
   {<<"optional">>,true},
   {<<"requirement">>,<<"~> 3.0">>},
   {<<"repository">>,<<"hexpm">>}]]}.
{<<"build_tools">>,[<<"mix">>]}.
