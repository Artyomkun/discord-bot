{<<"links">>,[{<<"github">>,<<"https://github.com/qqwy/elixir-rational">>}]}.
{<<"name">>,<<"ratio">>}.
{<<"version">>,<<"4.0.1">>}.
{<<"description">>,
 <<"This library allows you to use Rational numbers in Elixir, to enable exact calculations with all numbers big and small.">>}.
{<<"elixir">>,<<"~> 1.6">>}.
{<<"app">>,<<"ratio">>}.
{<<"files">>,
 [<<"lib">>,<<"lib/ratio.ex">>,<<"lib/ratio">>,<<"lib/ratio/numbers.ex">>,
  <<"lib/ratio/decimal_conversion.ex">>,<<"lib/ratio/float_conversion.ex">>,
  <<"lib/ratio/coerce.ex">>,<<"mix.exs">>,<<"README.md">>,<<"LICENSE">>]}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"requirements">>,
 [[{<<"name">>,<<"numbers">>},
   {<<"app">>,<<"numbers">>},
   {<<"optional">>,false},
   {<<"requirement">>,<<"~> 5.2.0">>},
   {<<"repository">>,<<"hexpm">>}],
  [{<<"name">>,<<"decimal">>},
   {<<"app">>,<<"decimal">>},
   {<<"optional">>,true},
   {<<"requirement">>,<<"~> 1.6 or ~> 2.0">>},
   {<<"repository">>,<<"hexpm">>}]]}.
{<<"build_tools">>,[<<"mix">>]}.
