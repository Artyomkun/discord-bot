{<<"app">>,<<"grpc_statsd">>}.
{<<"build_tools">>,[<<"mix">>]}.
{<<"description">>,
 <<"statsd interceptor/middleware for https://github.com/elixir-grpc/grpc">>}.
{<<"elixir">>,<<"~> 1.4">>}.
{<<"files">>,
 [<<".formatter.exs">>,<<"mix.exs">>,<<"lib">>,<<"lib/grpc_statsd">>,
  <<"lib/grpc_statsd/server_interceptor.ex">>,<<"lib/grpc_statsd.ex">>]}.
{<<"licenses">>,[<<"MIT">>]}.
{<<"links">>,
 [{<<"GitHub">>,<<"https://github.com/elixir-grpc/grpc-statsd">>}]}.
{<<"name">>,<<"grpc_statsd">>}.
{<<"requirements">>,
 [[{<<"app">>,<<"statix">>},
   {<<"name">>,<<"statix">>},
   {<<"optional">>,true},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<">= 0.0.0">>}],
  [{<<"app">>,<<"grpc">>},
   {<<"name">>,<<"grpc">>},
   {<<"optional">>,true},
   {<<"repository">>,<<"hexpm">>},
   {<<"requirement">>,<<">= 0.0.0">>}]]}.
{<<"version">>,<<"0.1.0">>}.
